# 数据库与缓存
DATABASE_URL="postgresql://user:password@localhost:5432/factory_matrix?schema=public"
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
PLATFORM_ROOT_DOMAIN="platform.com"
AUTH_SECRET="replace-with-a-long-random-string"

# Vercel Domains 自动化管理 (总站中台自动绑定独立域名)
VERCEL_PROJECT_ID="prj_xxxxxxx"
VERCEL_AUTH_BEARER_TOKEN="xxxxxxx"
VERCEL_TEAM_ID="team_xxxxxxx"

# Cloudflare R2 对象存储 (图片与PDF)
R2_ACCOUNT_ID="xxxxxxx"
R2_ACCESS_KEY_ID="xxxxxxx"
R2_SECRET_ACCESS_KEY="xxxxxxx"
R2_BUCKET_NAME="factory-matrix-assets"
R2_PUBLIC_DOMAIN="https://pub-r2.matrix-commerce.com"

# 飞书机器人通知
FEISHU_WEBHOOK_URL="https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxx"

# 支付接口凭据
STRIPE_SECRET_KEY="sk_test_xxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxx"

PAYPAL_CLIENT_ID="xxxxxxx"
PAYPAL_CLIENT_SECRET="xxxxxxx"
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"

BINANCE_PAY_API_KEY="xxxxxxx"
BINANCE_PAY_SECRET_KEY="xxxxxxx"
# Webhook 先验公钥。官方回调是 RSA-SHA256；本系统同时接受 RSA-SHA512。
BINANCE_PAY_PUBLIC_KEY=""
STATIC_USDT_TRC20_ADDRESS="Txxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# GitHub 审计归档 (可选)
GITHUB_AUDIT_REPO_TOKEN="ghp_xxxxxxx"
GITHUB_AUDIT_REPO_NAME="your-org/matrix-audit-logs"
